#!/bin/sh
#
# Pre-commit hook: Scans staged files for secrets and sensitive data
# Install: git config core.hooksPath .githooks
#

set -e

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo "🔍 Scanning for secrets and sensitive data..."

# Get list of staged files (excluding deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)

if [ -z "$STAGED_FILES" ]; then
  echo "${GREEN}✓ No files to scan${NC}"
  exit 0
fi

# Define secret patterns
# Each pattern is: "regex|description"
PATTERNS="
qwen_[a-zA-Z0-9]{32,}|Qwen API key
sk-[a-zA-Z0-9]{48,}|OpenAI/Anthropic API key
key-[a-zA-Z0-9]{32,}|Generic API key
password\s*[:=]\s*['\"][^'\"]+['\"]|Hardcoded password
secret\s*[:=]\s*['\"][^'\"]+['\"]|Hardcoded secret
token\s*[:=]\s*['\"][^'\"]+['\"]|Hardcoded token
jwt[_-]?secret\s*[:=]\s*['\"][^'\"]+['\"]|JWT secret
api[_-]?key\s*[:=]\s*['\"][^'\"]+['\"]|API key in code
ghp_[a-zA-Z0-9]{36,}|GitHub Personal Access Token
gho_[a-zA-Z0-9]{36,}|GitHub OAuth token
AKIA[0-9A-Z]{16}|AWS Access Key
-----BEGIN (RSA |EC )?PRIVATE KEY-----|Private key
BEGIN CERTIFICATE|Certificate file
"

FOUND_SECRETS=0

# Check each staged file
for file in $STAGED_FILES; do
  # Skip binary files
  if file "$file" | grep -q "binary"; then
    continue
  fi
  
  # Get staged content
  CONTENT=$(git show ":$file" 2>/dev/null || true)
  
  if [ -z "$CONTENT" ]; then
    continue
  fi
  
  # Check each pattern
  echo "$PATTERNS" | while IFS='|' read -r pattern description; do
    if [ -z "$pattern" ]; then
      continue
    fi
    
    # Use grep with extended regex (-- to prevent pattern being treated as option)
    if echo "$CONTENT" | grep -Eiq -- "$pattern"; then
      echo "${RED}⚠️  FOUND: $description${NC}"
      echo "   File: $file"
      echo "   Pattern: $pattern"
      echo ""
      FOUND_SECRETS=1
    fi
  done
done

# Check for .env files (should be in .gitignore but double-check)
if echo "$STAGED_FILES" | grep -qE "^\.env"; then
  echo "${RED}⚠️  FOUND: .env file${NC}"
  echo "   Environment files should never be committed"
  FOUND_SECRETS=1
fi

# Check for database dumps
if echo "$STAGED_FILES" | grep -qE "\.(sql|db|sqlite)$"; then
  echo "${RED}⚠️  FOUND: Database file${NC}"
  echo "   Database dumps should never be committed"
  FOUND_SECRETS=1
fi

# Check for resume/PDF files
if echo "$STAGED_FILES" | grep -qE "\.(pdf|docx)$"; then
  echo "${RED}⚠️  FOUND: Resume/document file${NC}"
  echo "   Personal documents should never be committed"
  FOUND_SECRETS=1
fi

# Exit with error if secrets found
if [ $FOUND_SECRETS -ne 0 ]; then
  echo ""
  echo "${RED}❌ Commit blocked: Secrets or sensitive data detected${NC}"
  echo ""
  echo "To fix:"
  echo "  1. Remove the sensitive data from your code"
  echo "  2. Use environment variables instead (see .env.example)"
  echo "  3. If this is a false positive, use: git commit --no-verify"
  echo ""
  exit 1
fi

echo "${GREEN}✓ No secrets detected${NC}"
exit 0
