// Prisma Schema — PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  aliases     Json     @default("[]")
  website     String?
  careers_url String?
  industry    String?
  size        String?
  location    Json?
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  jobs        Job[]

  @@index([name])
}

model Job {
  id                      String   @id @default(cuid())
  title                   String
  company_id              String
  location                Json
  description             String
  requirements            Json     @default("[]")
  salary_range            Json?
  job_type                String
  seniority_level         String?
  is_remote               Boolean  @default(false)
  posted_date             DateTime?
  closing_date            DateTime?
  tags                    Json     @default("[]")
  direct_apply_url        String?
  direct_apply_confidence String?
  status                  String   @default("active")
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  company                 Company  @relation(fields: [company_id], references: [id])
  sources                 Source[]
  matches                 Match[]

  @@index([title])
  @@index([company_id])
  @@index([status])
  @@index([posted_date])
}

model Source {
  id              String    @id @default(cuid())
  job_id          String
  board           String
  board_job_id    String
  url             String
  scraped_at      DateTime  @default(now())
  raw_payload     Json?
  status          String    @default("active")
  last_checked_at DateTime?

  job             Job       @relation(fields: [job_id], references: [id], onDelete: Cascade)
  board_rel       Board     @relation(fields: [board], references: [name])

  @@unique([job_id, board, board_job_id])
  @@index([job_id])
  @@index([board])
}

model Board {
  id            String   @id @default(cuid())
  name          String   @unique
  adapter_class String
  config        Json
  enabled       Boolean  @default(true)
  health        Json     @default("{}")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  sources       Source[]
  companies     BoardCompany[]
}

model BoardCompany {
  id            String   @id @default(cuid())
  board         String
  company_id    String
  company_name  String?
  metadata      Json     @default("{}")
  last_checked  DateTime?
  success_count Int      @default(0)
  failure_count Int      @default(0)
  enabled       Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  board_rel     Board    @relation(fields: [board], references: [name], onDelete: Cascade)

  @@unique([board, company_id])
  @@index([board])
  @@index([enabled])
}

model Profile {
  id             String   @id @default(cuid())
  name           String
  email          String?
  phone          String?
  location       Json?
  experience     Json     @default("[]")
  education      Json     @default("[]")
  certifications Json     @default("[]")
  skills         Json     @default("[]")
  preferences    Json     @default("{}")
  search_queries Json     @default("[]")
  resume         Json
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  matches        Match[]
  resumes        Resume[]
}

model Resume {
  id                String          @id @default(cuid())
  profile_id        String
  title             String          @default("Untitled resume")
  format            String          @default("compact")
  status            String          @default("NEW") // NEW | SAVED | ARCHIVED
  primary           Boolean         @default(false)
  original_raw_text String? // NULL if created blank; never updated after creation (ADR-0008)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  profile           Profile         @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  versions          ResumeVersion[]

  @@index([profile_id])
  @@index([primary])
}

model ResumeVersion {
  id         String   @id @default(cuid())
  resume_id  String
  revision   Int // additive, 0-based; DATE-primary display with revision disambiguation
  created_at DateTime @default(now())
  data       Json // canonical ResumeDoc blob (ADR-0004 §6.5)

  resume     Resume   @relation(fields: [resume_id], references: [id], onDelete: Cascade)

  @@unique([resume_id, revision])
  @@index([resume_id])
}

model Match {
  id         String   @id @default(cuid())
  profile_id String
  job_id     String
  score      Float
  dimensions Json
  reasons    Json     @default("[]")
  flags      Json     @default("[]")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profile    Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  job        Job      @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@unique([profile_id, job_id])
  @@index([profile_id])
  @@index([job_id])
  @@index([score])
}

model Application {
  id          String   @id @default(cuid())
  profile_id  String
  job_id      String
  status      String   @default("saved")
  notes       Json     @default("[]")
  applied_via String?
  applied_url String?
  applied_at  DateTime?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([profile_id, job_id])
  @@index([profile_id])
  @@index([job_id])
  @@index([status])
}