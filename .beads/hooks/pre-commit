#!/bin/sh
#
# Pre-commit hook: Scans staged files for secrets and sensitive data
# Install: git config core.hooksPath .githooks
#

set -e

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo "🔍 Scanning for secrets and sensitive data..."

# Get list of staged files (excluding deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)

if [ -z "$STAGED_FILES" ]; then
  echo "${GREEN}✓ No files to scan${NC}"
  exit 0
fi

# Define secret patterns
# Each pattern is: "regex~~~description"
PATTERNS="
qwen_[a-zA-Z0-9]{32,}~~~Qwen API key
sk-[a-zA-Z0-9]{48,}~~~OpenAI/Anthropic API key
key-[a-zA-Z0-9]{32,}~~~Generic API key
password\s*[:=]\s*['\"][^'\"]+['\"]~~~Hardcoded password
secret\s*[:=]\s*['\"][^'\"]+['\"]~~~Hardcoded secret
token\s*[:=]\s*['\"][^'\"]+['\"]~~~Hardcoded token
jwt[_-]?secret\s*[:=]\s*['\"][^'\"]+['\"]~~~JWT secret
api[_-]?key\s*[:=]\s*['\"][^'\"]+['\"]~~~API key in code
ghp_[a-zA-Z0-9]{36,}~~~GitHub Personal Access Token
gho_[a-zA-Z0-9]{36,}~~~GitHub OAuth token
AKIA[0-9A-Z]{16}~~~AWS Access Key
-----BEGIN\s+(RSA\s+|EC\s+)?PRIVATE\s+KEY-----~~~Private key
BEGIN\s+CERTIFICATE~~~Certificate file
"

FOUND_SECRETS=0

# Check each staged file
for file in $STAGED_FILES; do
  # Skip binary files
  if file "$file" | grep -q "binary"; then
    continue
  fi
  
  # Get staged content
  CONTENT=$(git show ":$file" 2>/dev/null || true)
  
  if [ -z "$CONTENT" ]; then
    continue
  fi
  
  # Check each pattern
  echo "$PATTERNS" | while IFS='~~~' read -r pattern description; do
    if [ -z "$pattern" ]; then
      continue
    fi
    
    # Use grep with extended regex (-- to prevent pattern being treated as option)
    if echo "$CONTENT" | grep -Eiq -- "$pattern"; then
      echo "${RED}⚠️  FOUND: $description${NC}"
      echo "   File: $file"
      echo "   Pattern: $pattern"
      echo ""
      FOUND_SECRETS=1
    fi
  done
done

# Check for .env files with secrets (exclude .env.example, .env.template, etc.)
ENV_FILES=$(echo "$STAGED_FILES" | grep -E "^\.env(\.[a-zA-Z0-9_-]+)?$" | grep -vE "\.(example|template|sample)$" || true)
if [ -n "$ENV_FILES" ]; then
  echo "${RED}⚠️  FOUND: .env file with potential secrets${NC}"
  echo "   $ENV_FILES"
  echo "   (Use .env.example for templates)"
  FOUND_SECRETS=1
fi

# Check for database dumps
if echo "$STAGED_FILES" | grep -qE "\.(sql|db|sqlite)$"; then
  echo "${RED}⚠️  FOUND: Database file${NC}"
  echo "   Database dumps should never be committed"
  FOUND_SECRETS=1
fi

# Check for resume/PDF files
if echo "$STAGED_FILES" | grep -qE "\.(pdf|docx)$"; then
  echo "${RED}⚠️  FOUND: Resume/document file${NC}"
  echo "   Personal documents should never be committed"
  FOUND_SECRETS=1
fi

# Exit with error if secrets found
if [ $FOUND_SECRETS -ne 0 ]; then
  echo ""
  echo "${RED}❌ Commit blocked: Secrets or sensitive data detected${NC}"
  echo ""
  echo "To fix:"
  echo "  1. Remove the sensitive data from your code"
  echo "  2. Use environment variables instead (see .env.example)"
  echo "  3. If this is a false positive, use: git commit --no-verify"
  echo ""
  exit 1
fi

echo "${GREEN}✓ No secrets detected${NC}"
exit 0

# --- BEGIN BEADS INTEGRATION v1.1.2 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  _bd_used_perl=0
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v perl >/dev/null 2>&1; then
    _bd_used_perl=1
    perl -e 'alarm shift; exec @ARGV' "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  else
    echo >&2 "beads: hook 'pre-commit' running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT"
    bd hooks run pre-commit "$@"
    _bd_exit=$?
  fi
  if [ $_bd_exit -eq 124 ] || { [ $_bd_used_perl -eq 1 ] && [ $_bd_exit -eq 142 ]; }; then
    echo >&2 "beads: hook 'pre-commit' timed out after ${_bd_timeout}s — continuing without beads"
    _bd_exit=0
  fi
  if [ $_bd_exit -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-commit'"
    _bd_exit=0
  fi
  if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION v1.1.2 ---
