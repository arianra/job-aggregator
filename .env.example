# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/job_aggregator
DATABASE_NAME=job_aggregator
DATABASE_USER=username
DATABASE_PASSWORD=password

# Qwen Cloud API (for resume parsing and AI features)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_API_ENDPOINT=https://api.qwen.ai/v1

# Job Board API Keys (if applicable)
LINKEDIN_API_KEY=your_linkedin_api_key
INDEED_API_KEY=your_indeed_api_key
GLASSDOOR_API_KEY=your_glassdoor_api_key

# Application Settings
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Security
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_32_character_encryption_key

# Optional: External Services
SENTRY_DSN=your_sentry_dsn
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
