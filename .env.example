# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection string (used by backend + Prisma)
DATABASE_URL=postgresql://username:password@localhost:5432/job_aggregator

# Docker Compose PostgreSQL credentials
POSTGRES_USER=job_aggregator
POSTGRES_PASSWORD=password
POSTGRES_DB=job_aggregator

# =============================================================================
# Qwen Cloud API (resume parsing & AI features)
# =============================================================================
QWEN_API_KEY=your_qwen_api_key_here
QWEN_API_ENDPOINT=https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic/v1

# =============================================================================
# Application Settings
# =============================================================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# =============================================================================
# Frontend
# =============================================================================
VITE_API_URL=http://localhost:3000/api

# =============================================================================
# Optional: External Services
# =============================================================================
RAPIDAPI_KEY=your_rapidapi_key_here

# Security
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_32_character_encryption_key

# Email (optional)
SENTRY_DSN=your_sentry_dsn
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# =============================================================================
# Test Configuration
# =============================================================================
# Separate database for tests (auto-created by setup script)
TEST_DATABASE_URL=postgresql://job_aggregator:password@localhost:5432/job_aggregator_test
